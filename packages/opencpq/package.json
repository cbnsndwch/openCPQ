{
    "name": "@cbnsndwch/opencpq",
    "version": "0.0.0",
    "description": "A headless React 19 library for in-browser product configuration (CPQ)",
    "keywords": [
        "CPQ",
        "configuration",
        "headless",
        "product configuration",
        "react",
        "react-component"
    ],
    "homepage": "https://github.com/cbnsndwch/openCPQ",
    "bugs": "https://github.com/cbnsndwch/openCPQ/issues",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cbnsndwch/openCPQ.git",
        "directory": "packages/opencpq"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "oxlint src",
        "format": "oxfmt src",
        "clean": "rimraf dist"
    },
    "devDependencies": {
        "@testing-library/react": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitejs/plugin-react": "catalog:",
        "jsdom": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "rimraf": "catalog:",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "engines": {
        "node": ">=20"
    }
}
