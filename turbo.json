{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": [
                "src/**",
                "tsconfig.json",
                "tsup.config.ts",
                "vite.config.ts",
                "vitest.config.ts",
                "package.json",
                "index.html"
            ],
            "outputs": ["dist/**", ".vite/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "inputs": ["src/**", "tsconfig.json", "package.json"]
        },
        "test": {
            "dependsOn": ["^build"],
            "inputs": ["src/**", "vitest.config.ts", "package.json"]
        },
        "lint": {
            "inputs": ["src/**", ".oxlintrc.json"]
        },
        "clean": {
            "cache": false
        }
    }
}
