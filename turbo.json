{
    "$schema": "https://turbo.build/schema.json",
    "ui": "stream",
    "tasks": {
        "clean": {
            "dependsOn": ["^clean"],
            "outputs": ["dist/**", "lib/**"]
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", "build/**", "lib/**"]
        },
        "dev": {
            "dependsOn": ["^dev"],
            "outputs": ["dist/**", "build/**", "lib/**"]
        },
        "lint": {
            "outputs": []
        },
        "format": {
            "dependsOn": ["^format"],
            "outputs": []
        },
        "test": {
            "dependsOn": ["^test"],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "inputs": ["src/**", "tsconfig.json", "package.json"]
        }
    }
}
