# Dependencies & Build Output
# Contains compiled code, build artifacts, and vendor dependencies
node_modules
**/node_modules
dist
build
*.tsbuildinfo

# Yarn Configuration & Caches
# Ignores local package manager caches but keeps required plugin and release files
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
.pnp.*
**/.pnp.*

# Testing & Coverage
# Outputs from testing frameworks and coverage tools
coverage
/coverage
/.nyc_output
**/test-results/
**/playwright-report/

# Logs & Temporary Files
# General system, npm, and tool-specific log files and local temp files
*~
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.local
changelog-temp.md
dogfood-output
.n

# IDEs, Editors, & OS Files
# Workspace configurations, caches for IDEs, and OS-specific files
.DS_Store
.idea
/.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
**/.claude/worktrees/
**/.claude/settings.local.json

# Environments & Credentials
# Secrets, local environment settings, avoiding accidentally committing sensitive data
*credentials
.env.*
**/.env*
!.env.example

# Tooling & Framework Specific
# Caches and state files for specific tools (e.g. Turbo, Cloudflare Wrangler, React Router)
.turbo/
/.turbo/daemon
/.turbo/cookies
/.turbo/cache
/.turbo/preferences/tui.json
.react-router
**/.wrangler/
stats.html
**/stats.html
yarn.lock
